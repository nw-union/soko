{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "**/*.svelte",
      "**/*.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noNestedComponentDefinitions": "off" // コンポーネント内でローカルコンポーネントを定義する場合があるため
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "globals": ["Env", "ExecutionContext"]
  },
  "overrides": [
    {
      // Web 層は domain/<Context>/api.ts の型と、server/container.ts の …Usecase を使うだけにする。DB は adapter/ だけが触る
      "includes": [
        "pages/**",
        "routes/**",
        "middleware/**",
        "crons/**",
        "auth.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "void/db",
                      "@schema",
                      "@schema/**",
                      "**/adapter/**",
                      "**/db/schema*"
                    ],
                    "message": "Web 層から DB を直接触らない。…Usecase にコマンドか Query を足し、server/container.ts から呼ぶ"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // auth.ts から読み込まれるファイル。Void の CLI は拡張子なしの相対 import を解決できないため、.ts を付ける
      "includes": ["domain/**", "adapter/**", "server/**", "lib/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@schema", "@schema/**"],
                    "message": "Void の CLI は Vite のエイリアスを解決できない。db/schema.ts を相対パスで import する"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // ドメイン層は純粋な TypeScript にする。フレームワーク・DB・画面には依存しない（依存の向きは adapter/ → domain/）
      "includes": ["domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "void",
                      "void/**",
                      "@void/**",
                      "hono",
                      "hono/**",
                      "@schema",
                      "@schema/**",
                      "better-auth",
                      "better-auth/**",
                      "@better-auth/**",
                      "svelte",
                      "svelte/**"
                    ],
                    "message": "domain/ はフレームワークや DB に依存させない。Port を定義して adapter/ で実装する"
                  },
                  {
                    "group": [
                      "**/src/**",
                      "**/pages/**",
                      "**/routes/**",
                      "**/crons/**",
                      "**/middleware/**",
                      "**/db/**",
                      "**/adapter/**",
                      "**/server/**"
                    ],
                    "message": "domain/ から外側の層を import しない（依存の向きは外側 → domain/）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // ブラウザからも import するアプリの決まりごと（domain/Member/rule.ts）。
      // VO のパーサー（lib/vo）や VO・エラーを import すると、クライアントのバンドルに入るので禁止する
      "includes": ["domain/**/rule.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "void",
                      "void/**",
                      "@void/**",
                      "hono",
                      "hono/**",
                      "@schema",
                      "@schema/**",
                      "better-auth",
                      "better-auth/**",
                      "@better-auth/**",
                      "svelte",
                      "svelte/**"
                    ],
                    "message": "domain/ はフレームワークや DB に依存させない。Port を定義して adapter/ で実装する"
                  },
                  {
                    "group": [
                      "**/src/**",
                      "**/pages/**",
                      "**/routes/**",
                      "**/crons/**",
                      "**/middleware/**",
                      "**/db/**",
                      "**/adapter/**",
                      "**/server/**"
                    ],
                    "message": "domain/ から外側の層を import しない（依存の向きは外側 → domain/）"
                  },
                  {
                    "group": [
                      "@nw-union/nw-utils/lib/vo",
                      "**/vo.ts",
                      "**/shared/error.ts"
                    ],
                    "message": "ブラウザからも使うファイルでは lib/vo・VO・エラーを import しない。クライアントのバンドルに入る"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // どの層からも（ブラウザからも）使う汎用の関数（base64url・youtube・url）。アプリのどの層にも、フレームワークにも依存しない
      "includes": ["lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "void",
                      "void/**",
                      "@void/**",
                      "hono",
                      "hono/**",
                      "@schema",
                      "@schema/**",
                      "better-auth",
                      "better-auth/**",
                      "@better-auth/**",
                      "svelte",
                      "svelte/**"
                    ],
                    "message": "lib/ はフレームワークに依存させない"
                  },
                  {
                    "group": [
                      "**/src/**",
                      "**/pages/**",
                      "**/routes/**",
                      "**/crons/**",
                      "**/middleware/**",
                      "**/db/**",
                      "**/adapter/**",
                      "**/server/**",
                      "**/domain/**"
                    ],
                    "message": "lib/ からアプリの層を import しない"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
