{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "**/*.svelte",
      "**/*.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noNestedComponentDefinitions": "off" // コンポーネント内でローカルコンポーネントを定義する場合があるため
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "globals": ["Env", "ExecutionContext"]
  },
  "overrides": [
    {
      // ドメイン層は純粋な TypeScript にする。フレームワーク・DB・画面には依存しない（依存の向きは adapter/ → domain/）
      "includes": ["domain/**", "error.ts", "error.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            // auth.ts から読み込まれ、Void の CLI は拡張子なしの相対 import を解決できないため
            "useImportExtensions": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "void",
                      "void/**",
                      "@void/**",
                      "hono",
                      "hono/**",
                      "@schema",
                      "@schema/**",
                      "better-auth",
                      "better-auth/**",
                      "@better-auth/**",
                      "svelte",
                      "svelte/**"
                    ],
                    "message": "domain/ はフレームワークや DB に依存させない。Port を定義して adapter/ で実装する"
                  },
                  {
                    "group": [
                      "**/src/**",
                      "**/pages/**",
                      "**/routes/**",
                      "**/crons/**",
                      "**/middleware/**",
                      "**/db/**",
                      "**/adapter/**",
                      "**/server/**"
                    ],
                    "message": "domain/ から外側の層を import しない（依存の向きは外側 → domain/）"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
